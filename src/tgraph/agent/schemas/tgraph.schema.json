{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "nodes", "links"],
  "properties": {
    "stage": { "enum": ["logical", "physical"] },
    "nodes": { "type": "array", "items": { "type": "object" } },
    "links": { "type": "array", "items": { "type": "object" } }
  }
}

